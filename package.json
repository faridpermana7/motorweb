  "description": "Premium Dashboard for Bootstrap 5",
  "main": "/sign-in.html",
  "directories": {
    "example": "root"
  },
  "scripts": {
    "dev": "webpack serve --mode development --host localhost --port 8081",
    "start": "webpack serve --mode development --host localhost --port 8081 --open",
